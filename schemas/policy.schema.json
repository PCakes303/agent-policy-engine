{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PCakes303/agent-policy-engine/blob/main/schemas/policy.schema.json",
  "title": "Agent Policy Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "policy_id",
    "default_effect",
    "rules"
  ],
  "properties": {
    "policy_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "default_effect": {
      "const": "deny"
    },
    "description": {
      "type": "string",
      "maxLength": 1024
    },
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "effect",
          "principals",
          "actions",
          "resources",
          "required_scopes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "effect": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "principals": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required_scopes": {
            "type": "array",
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      }
    }
  }
}
